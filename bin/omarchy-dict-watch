#!/usr/bin/env bash
# omarchy-dict-watch -- offline dictionary lookups for the Dictionary plugin.
#
# Modes:
#   omarchy-dict-watch                 watch the Wayland primary selection
#                                      (plain highlighting) and emit one JSON
#                                      line per accepted selection
#   omarchy-dict-watch --lookup WORD   look one word up now (IPC / keybinding)
#   omarchy-dict-watch --selection     look up the current primary selection now
#   omarchy-dict-watch --state [on|off]  read / persist the bar toggle
#
# Output (one line):
#   {"query","word","via","entries":[{dict,word,definition}],
#    "lemma":{"word","relation","entries"}|null,"suggestions":[..],
#    "found":bool,"x":N,"y":N}
#   via: "exact" | "lowercase" | "stem" -- how `word` was reached from `query`
#   lemma: set when the entry says "plural of cat" / "past tense of go": the
#          base word's entry, so the card can show what the word MEANS
#   suggestions: near-miss headwords when nothing matched exactly (the card
#          shows them as "Did you mean"; they are never shown as definitions)
# or {"error":"no-dictionary"} when sdcv or a dictionary is missing.
#
# Why `wl-paste --watch "$0" --handle` instead of a read loop: --watch re-execs
# its command once per selection change with the content on stdin; piping it
# into `while read` silently drops every event (verified). Same pattern as
# Omarchy's own clipboard plugin.
set -uo pipefail

MAX_LEN=48          # "ice cream", "hors d'oeuvre" -- not sentences
MAX_WORDS=2
DEBOUNCE=0.25       # a mouse drag updates the selection many times
STARTUP_GRACE_US=700000   # --watch fires once at start with the OLD selection

# Selections in these windows are never looked up (they may be secrets).
# Case-insensitive match against the focused window's class.
DENY_CLASSES="${OMARCHY_DICT_DENY_CLASSES:-1password|keepassxc|keepass|bitwarden|pinentry|gcr-prompter|seahorse|kwalletmanager|polkit|enpass|proton-pass|protonpass}"

runtime="${OMARCHY_DICT_RUNTIME:-${XDG_RUNTIME_DIR:-/tmp}/omarchy-dictionary-$UID}"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-dictionary"

log() { printf '[dict] %s\n' "$*" >&2; }  # stderr only -- stdout is the JSON stream

# ---- lookups -------------------------------------------------------------

exact() { sdcv -n -e --json-output -- "$1" 2>/dev/null; }

nonempty() { [[ -n "$1" && "$1" != "[]" ]]; }

# Candidate base forms for an inflected English word, most likely first.
stems() {
  local w="$1" b
  case "$w" in
    *\'s|*’s) printf '%s\n' "${w%??}" ;;
  esac
  case "$w" in
    *ies) printf '%s\n' "${w%ies}y" ;;
    *ied) printf '%s\n' "${w%ied}y" ;;
    *ier) printf '%s\n' "${w%ier}y" ;;
    *iest) printf '%s\n' "${w%iest}y" ;;
  esac
  case "$w" in
    *ing) b="${w%ing}"; printf '%s\n' "$b" "${b}e"
          [[ "$b" =~ (.)\1$ ]] && printf '%s\n' "${b%?}" ;;
    *ed)  b="${w%ed}"; printf '%s\n' "$b" "${w%d}"
          [[ "$b" =~ (.)\1$ ]] && printf '%s\n' "${b%?}" ;;
    *es)  printf '%s\n' "${w%es}" "${w%s}" ;;
    *ss)  ;;
    *s)   printf '%s\n' "${w%s}" ;;
  esac
  case "$w" in
    *ly)  printf '%s\n' "${w%ly}" ;;
    *est) printf '%s\n' "${w%est}" ;;
    *er)  printf '%s\n' "${w%er}" "${w%r}" ;;
  esac
}

# First "plural of X" / "past tense of X"-style reference in the ENGLISH part
# of an entry (foreign-language sections start with "Language pos." lines).
# Prints: relation \t lemma
form_of() {
  jq -r '.[0].definition // ""' <<<"$1" |
    awk '/^[A-Z][a-z]+( [A-Z][a-z]+)? [a-z.]+\.$/ { exit } { print }' |
    grep -oP '\((plural|infl|inflection|past participle|present participle|simple past|past tense|comparative|superlative|alternative form|alternative spelling|alternative case form|obsolete form|obsolete spelling|archaic form|archaic spelling|misspelling|informal spelling|nonstandard spelling|clipping|clip|abbreviation|abbr|initialism|acronym|ellipsis|synonym|syn) of en \K[^()=]+?(?=  | [a-z]+=|\))' |
    head -1 |
    sed -e 's/[[:space:]]*$//'
}

# The same, from raw templates the converter left in place:
# "{{deliberate misspelling of|en|the|addl=...}}" -> the
form_of_raw() {
  jq -r '.[0].definition // ""' <<<"$1" | grep -oP '\{\{[a-z ]+ of\|en\|\K[^|}]+' | head -1
}

# Relation label for the lemma line, e.g. "plural of", "past tense of".
relation_of() {
  local def="$1" lemma="$2"
  jq -r '.[0].definition // ""' <<<"$def" |
    grep -oP "\\((plural|infl|inflection|past participle|present participle|simple past|past tense|comparative|superlative|alternative form|alternative spelling|alternative case form|obsolete form|obsolete spelling|archaic form|archaic spelling|misspelling|informal spelling|nonstandard spelling|clipping|clip|abbreviation|abbr|initialism|acronym|ellipsis|synonym|syn) of en \\Q$lemma\\E[^)]*\\)" |
    head -1
}

# Does an entry have English senses? Template language codes tell:
# "(lb en ...)", "(senseid en ...)", "(plural of en ...)". An entry with no
# codes at all is a plain English entry. (Mirrors Model.js parseDefinition.)
english_like() {
  local def
  def="$(jq -r '[.[].definition] | join("\n")' <<<"$1")"
  grep -qP '\((?:lb|lbl|l|m|senseid|sid|[a-z ]+ of) en ' <<<"$def" && return 0
  ! grep -qP '\((?:lb|lbl|l|m|senseid|sid) [a-z]{2,3}(?:-[a-z]+)? ' <<<"$def"
}

# Near-miss headwords for a word that didn't match (single words only).
# sdcv's glob search returns at most 100 headwords, alphabetically, so a
# short prefix alone misses long words: use a long prefix, a half-word
# prefix, and "first3*last2" (catches swapped letters: rec*ve -> receive),
# plus exact lookups of every adjacent-letter swap (teh -> the). ~0.3-0.8s,
# paid only on a miss.
candidates() {
  local w="$1" n=${#1} i sw
  [[ "$w" != *" "* && $n -ge 3 ]] || { echo '[]'; return; }
  {
    (( n >= 5 )) && sdcv -n --json-output -- "${w:0:n-2}*" 2>/dev/null
    sdcv -n --json-output -- "${w:0:$(( n / 2 > 3 ? n / 2 : 3 ))}*" 2>/dev/null
    (( n >= 6 )) && sdcv -n --json-output -- "${w:0:3}*${w: -2}" 2>/dev/null
    for (( i = 0; i < n - 1; i++ )); do
      sw="${w:0:i}${w:i+1:1}${w:i:1}${w:i+2}"
      [[ "$sw" != "$w" ]] && exact "$sw"
    done
  } | jq -s -c '[.[][]?.word] | unique | .[:400]' 2>/dev/null
}

lookup() {  # $1 query -> JSON line on stdout
  local query="$1" lower word="" via="" entries="[]" c lemma="" lemma_json="null" rel suggestions="[]"
  lower="${query,,}"

  entries="$(exact "$query")"
  if nonempty "$entries"; then word="$query"; via="exact"
  elif [[ "$lower" != "$query" ]] && entries="$(exact "$lower")" && nonempty "$entries"; then
    word="$lower"; via="lowercase"
  else
    entries="[]"
    if [[ "$lower" != *" "* ]]; then
      while IFS= read -r c; do
        [[ -n "$c" && ${#c} -ge 2 && "$c" != "$lower" ]] || continue
        entries="$(exact "$c")"
        if nonempty "$entries"; then word="$c"; via="stem"; break; fi
        entries="[]"
      done < <(stems "$lower")
    fi
  fi

  if nonempty "$entries" && ! english_like "$entries"; then
    # Exact hit, but only as a word in other languages ("teh"): keep the
    # entry and still collect English near-misses for "Did you mean".
    suggestions="$(candidates "$lower")"
    [[ -n "$suggestions" ]] || suggestions="[]"
  fi

  if nonempty "$entries"; then
    lemma="$(form_of "$entries")"
    [[ -n "$lemma" ]] || lemma="$(form_of_raw "$entries")"
    if [[ -n "$lemma" && "${lemma,,}" != "${word,,}" ]]; then
      local lemma_entries
      lemma_entries="$(exact "$lemma")"
      if nonempty "$lemma_entries"; then
        rel="$(relation_of "$entries" "$lemma")"
        [[ -n "$rel" ]] || rel="$(jq -r '.[0].definition // ""' <<<"$entries" | grep -oP "\\{\\{[a-z ]+ of\\|en\\|\\Q$lemma\\E[^}]*\\}\\}" | head -1)"
        lemma_json="$(jq -c --arg w "$lemma" --arg rel "$rel" '{word: $w, relation: $rel, entries: .}' <<<"$lemma_entries")"
      fi
    fi
  else
    # Nothing matched: collect near-miss HEADWORDS for "Did you mean".
    # (v0.1 used sdcv's fuzzy search and showed those words' definitions as
    # if they belonged to the query.) Model.js ranks these by edit distance
    # and drops anything that isn't close.
    suggestions="$(candidates "$lower")"
    [[ -n "$suggestions" ]] || suggestions="[]"
  fi

  local pos x y
  pos="$(hyprctl cursorpos 2>/dev/null)"
  x="${pos%%,*}"; y="${pos##*, }"
  [[ "$x" =~ ^-?[0-9]+$ ]] || x=0
  [[ "$y" =~ ^-?[0-9]+$ ]] || y=0

  jq -nc --arg q "$query" --arg w "$word" --arg via "$via" \
    --argjson entries "$entries" --argjson lemma "$lemma_json" --argjson sugg "$suggestions" \
    --argjson x "$x" --argjson y "$y" \
    '{query: $q, word: $w, via: $via, entries: $entries, lemma: $lemma,
      suggestions: $sugg, found: (($entries | length) > 0), x: $x, y: $y}'
}

# Trim, collapse whitespace and strip surrounding punctuation/quotes.
# Prints nothing if the selection doesn't look like a word or short phrase.
normalize() {
  local t="$1"
  t="${t//$'\r'/ }"; t="${t//$'\n'/ }"; t="${t//$'\t'/ }"
  (( ${#t} <= MAX_LEN * 2 )) || return 0
  t="$(printf '%s' "$t" | tr -s ' ' | sed -E "s/^[[:space:][:punct:]“”‘’«»]+//; s/[[:space:][:punct:]“”‘’«»]+$//")"
  (( ${#t} >= 2 && ${#t} <= MAX_LEN )) || return 0
  local -a words
  read -r -a words <<<"$t"
  (( ${#words[@]} <= MAX_WORDS )) || return 0
  # Letters (any script), with inner apostrophes or hyphens. Anything with
  # digits, slashes, dots, @ ... is code, a path, a URL or a secret -- not a
  # dictionary word.
  local w
  for w in "${words[@]}"; do
    [[ "$w" =~ ^[[:alpha:]]+([\'’-][[:alpha:]]+)*$ ]] || return 0
  done
  printf '%s' "$t"
}

denied_window() {
  local cls
  cls="$(hyprctl activewindow -j 2>/dev/null | jq -r '(.class // "") + " " + (.initialClass // "")' 2>/dev/null)"
  [[ -n "$DENY_CLASSES" && "${cls,,}" =~ ($DENY_CLASSES) ]]
}

have_dictionary() {
  command -v sdcv >/dev/null 2>&1 || { log "sdcv not found on PATH"; return 1; }
  local n
  n="$(sdcv -l 2>/dev/null | tail -n +2 | grep -c . || true)"
  (( ${n:-0} > 0 )) || { log "sdcv has no dictionaries installed (sdcv -l is empty)"; return 1; }
}

handle_one() {
  # Invoked by wl-paste --watch once per selection change, content on stdin.
  local raw query now started seq mine
  raw="$(head -c 4096)"

  now="${EPOCHREALTIME/./}"
  started="${DICT_WATCH_STARTED:-0}"
  (( now - started >= STARTUP_GRACE_US )) || return 0

  query="$(normalize "$raw")"
  [[ -n "$query" ]] || return 0
  denied_window && return 0

  # Debounce: only the last selection of a burst gets looked up.
  mkdir -p "$runtime" && chmod 700 "$runtime"
  mine="$now"
  printf '%s\n' "$mine" > "$runtime/seq"
  sleep "$DEBOUNCE"
  read -r seq < "$runtime/seq" 2>/dev/null || seq=""
  [[ "$seq" == "$mine" ]] || return 0

  lookup "$query"
}

case "${1:-}" in
  --handle)
    handle_one
    exit 0
    ;;
  --lookup)
    have_dictionary || { echo '{"error":"no-dictionary"}'; exit 0; }
    q="$(normalize "${2:-}")"
    [[ -n "$q" ]] || q="${2:-}"
    [[ -n "$q" ]] && lookup "$q"
    exit 0
    ;;
  --selection)
    have_dictionary || { echo '{"error":"no-dictionary"}'; exit 0; }
    denied_window && { echo '{"error":"denied-window"}'; exit 0; }
    q="$(normalize "$(wl-paste --primary --no-newline 2>/dev/null | head -c 4096)")"
    if [[ -n "$q" ]]; then lookup "$q"; else echo '{"error":"no-word"}'; fi
    exit 0
    ;;
  --state)
    mkdir -p "$state_dir"
    case "${2:-}" in
      on|off) printf '%s\n' "$2" > "$state_dir/active" ;;
      *) cat "$state_dir/active" 2>/dev/null || echo off ;;
    esac
    exit 0
    ;;
esac

# ---- watch mode ----------------------------------------------------------

if ! have_dictionary; then
  echo '{"error":"no-dictionary"}'
  # Stay alive (idle) so Service.qml doesn't restart us in a tight loop.
  exec sleep infinity
fi

export DICT_WATCH_STARTED="${EPOCHREALTIME/./}"
exec wl-paste --primary --watch "$0" --handle
