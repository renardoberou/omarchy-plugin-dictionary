#!/usr/bin/env bash
# omarchy-dict-watch — watches the Wayland primary selection (plain
# highlighting, no Ctrl+C needed) and, for anything that passes a few
# sanity guards, runs an offline sdcv lookup and emits one JSON line per
# result to stdout for Service.qml to consume.
#
# Mode of operation: `wl-paste --watch <command>` re-execs <command> ONCE
# PER SELECTION CHANGE with the selection content on that invocation's
# stdin -- it does NOT behave like a persistent pipe source. Piping its
# output into a long-lived `while read` loop (the first thing tried here)
# silently loses every event -- verified live on this machine: a bare
# `wl-paste --primary --watch cat > file` captures correctly, but adding
# `| while read` after it produces nothing, ever. This mirrors the
# approach Omarchy's own first-party clipboard plugin uses
# (plugins/clipboard/capture.sh): let --watch invoke this same script
# per-event in "handle" mode, rather than fighting it with a loop.
#
# sdcv's `--json-output` flag (confirmed live: `sdcv -n --json-output
# <word>`) already returns a clean JSON array of {dict, word, definition}
# objects on a hit, `[]` on a miss (exit code 2) -- passed straight
# through as the `entries` field below.
set -uo pipefail

MAX_LEN=64  # a highlighted paragraph is not a dictionary lookup

log() { printf '%s\n' "$*" >&2; }  # stderr only — stdout is the JSON stream

no_dictionary_loop() {
  while true; do
    printf '%s\n' '{"error":"no-dictionary"}'
    sleep 3600 &
    wait $!
  done
}

handle_one() {
  # Invoked by wl-paste --watch, once per selection change, with the new
  # selection text on stdin.
  local text trimmed query pos x y entries_json found
  text="$(cat)"

  trimmed="$(printf '%s' "$text" | tr -d '[:space:]')"
  [[ -n "$trimmed" ]] || return 0          # empty / pure-whitespace
  [[ ${#text} -le $MAX_LEN ]] || return 0  # a paragraph, not a lookup

  query="$(printf '%s' "$text" | tr -s '[:space:]' ' ' | sed -e 's/^ //' -e 's/ $//')"
  [[ -n "$query" ]] || return 0

  pos="$(hyprctl cursorpos 2>/dev/null)"
  x="${pos%%,*}"
  y="${pos##*, }"
  x="${x:-0}"
  y="${y:-0}"

  entries_json="$(sdcv -n --json-output "$query" 2>/dev/null)"
  [[ -n "$entries_json" ]] || entries_json="[]"
  found=1
  [[ "$entries_json" != "[]" ]] || found=0

  jq -nc --arg q "$query" --argjson entries "$entries_json" --argjson found "$found" \
        --argjson x "$x" --argjson y "$y" \
        '{query:$q, entries:$entries, found:($found==1), x:$x, y:$y}'
}

if [[ "${1:-}" == "--handle" ]]; then
  handle_one
  exit 0
fi

# --- outer/daemon mode: set up the watcher, run forever ---

if ! command -v sdcv >/dev/null 2>&1; then
  log "sdcv not found on PATH"
  no_dictionary_loop
fi

# Detect "no dictionary database installed" once at startup, not per
# lookup — `sdcv -l` lists installed dictionaries; empty output means sdcv
# itself works but has nothing to search.
dict_count="$(sdcv -l 2>/dev/null | tail -n +2 | grep -c . || true)"
if [[ "${dict_count:-0}" -eq 0 ]]; then
  log "sdcv installed but no dictionary databases found (sdcv -l was empty)"
  no_dictionary_loop
fi

exec wl-paste --primary --watch "$0" --handle
