#!/usr/bin/env bash
# omarchy-dict-watch -- offline dictionary lookups for the Dictionary plugin.
#
# Modes:
#   omarchy-dict-watch                 watch the Wayland primary selection
#                                      (plain highlighting) and emit one JSON
#                                      line per accepted selection
#   omarchy-dict-watch --lookup WORD   look one word up now (IPC / keybinding)
#   omarchy-dict-watch --selection     look up the current primary selection now
#   omarchy-dict-watch --define        selection: a word -> dictionary; a phrase,
#                                      sentence or unknown word -> local model
#   omarchy-dict-watch --explain [TEXT]  local model on TEXT (or the selection)
#   omarchy-dict-watch --state [on|off]  read / persist the bar toggle
#
# Output (one line):
#   {"query","word","via","entries":[{dict,word,definition}],
#    "lemma":{"word","relation","entries"}|null,"suggestions":[..],
#    "found":bool,"x":N,"y":N}
#   via: "exact" | "lowercase" | "stem" -- how `word` was reached from `query`
#   lemma: set when the entry says "plural of cat" / "past tense of go": the
#          base word's entry, so the card can show what the word MEANS
#   suggestions: near-miss headwords when nothing matched exactly (the card
#          shows them as "Did you mean"; they are never shown as definitions)
# or {"error":"no-dictionary"} when sdcv or a dictionary is missing.
# Model output is separate: {"kind":"explain","query","model","text","done"},
# streamed, `text` holding everything so far (see explain() below).
#
# Why `wl-paste --watch "$0" --handle` instead of a read loop: --watch re-execs
# its command once per selection change with the content on stdin; piping it
# into `while read` silently drops every event (verified). Same pattern as
# Omarchy's own clipboard plugin.
set -uo pipefail

MAX_LEN=48          # "ice cream", "hors d'oeuvre" -- not sentences
MAX_WORDS=2
DEBOUNCE=0.25       # a mouse drag updates the selection many times
STARTUP_GRACE_US=700000   # --watch fires once at start with the OLD selection

# Selections in these windows are never looked up (they may be secrets).
# Case-insensitive match against the focused window's class.
DENY_CLASSES="${OMARCHY_DICT_DENY_CLASSES:-1password|keepassxc|keepass|bitwarden|pinentry|gcr-prompter|seahorse|kwalletmanager|polkit|enpass|proton-pass|protonpass}"

runtime="${OMARCHY_DICT_RUNTIME:-${XDG_RUNTIME_DIR:-/tmp}/omarchy-dictionary-$UID}"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-dictionary"

log() { printf '[dict] %s\n' "$*" >&2; }  # stderr only -- stdout is the JSON stream

# ---- reading the selection ----------------------------------------------

# The primary selection can hold anything an app offers: an image, a file
# list, rich text. v0.3.0 read it without asking for a type, so a selected
# image reached the model as raw PNG bytes and the card title filled with
# garbage. Always ask for text; if there's no text type, there's nothing.
read_selection() {  # $1 = max bytes
  wl-paste --primary --no-newline --type text 2>/dev/null | head -c "${1:-8192}" | tr -d '\000'
}

# Plain text only: reject anything with control bytes (binary that an app
# mislabelled as text). Tabs and newlines are fine.
is_text() {
  LC_ALL=C grep -qP '[\x01-\x08\x0b\x0c\x0e-\x1f\x7f]' <<<"$1" && return 1
  return 0
}

# ---- lookups -------------------------------------------------------------

exact() { sdcv -n -e --json-output -- "$1" 2>/dev/null; }

nonempty() { [[ -n "$1" && "$1" != "[]" ]]; }

# Candidate base forms for an inflected English word, most likely first.
stems() {
  local w="$1" b
  case "$w" in
    *\'s|*’s) printf '%s\n' "${w%??}" ;;
  esac
  case "$w" in
    *ies) printf '%s\n' "${w%ies}y" ;;
    *ied) printf '%s\n' "${w%ied}y" ;;
    *ier) printf '%s\n' "${w%ier}y" ;;
    *iest) printf '%s\n' "${w%iest}y" ;;
  esac
  case "$w" in
    *ing) b="${w%ing}"; printf '%s\n' "$b" "${b}e"
          [[ "$b" =~ (.)\1$ ]] && printf '%s\n' "${b%?}" ;;
    *ed)  b="${w%ed}"; printf '%s\n' "$b" "${w%d}"
          [[ "$b" =~ (.)\1$ ]] && printf '%s\n' "${b%?}" ;;
    *es)  printf '%s\n' "${w%es}" "${w%s}" ;;
    *ss)  ;;
    *s)   printf '%s\n' "${w%s}" ;;
  esac
  case "$w" in
    *ly)  printf '%s\n' "${w%ly}" ;;
    *est) printf '%s\n' "${w%est}" ;;
    *er)  printf '%s\n' "${w%er}" "${w%r}" ;;
  esac
}

# Wiktionary's entry text (the one with form-of templates). With several
# dictionaries installed, sdcv lists them in its own order -- WordNet may
# come first -- so pick by content, not position.
wikt_text() {
  jq -r '[.[] | select(.definition | test("\\((?:lb|l|m|senseid|sid|[a-z ]+ of) [a-z]{2,3} "))][0].definition // ""' <<<"$1"
}

# First "plural of X" / "past tense of X"-style reference in the ENGLISH part
# of the Wiktionary entry (foreign-language sections start with "Language
# pos." lines). Prints the lemma.
form_of() {
  wikt_text "$1" |
    awk '/^[A-Z][a-z]+( [A-Z][a-z]+)? [a-z.]+\.$/ { exit } { print }' |
    grep -oP '\((plural|infl|inflection|past participle|present participle|simple past|past tense|comparative|superlative|alternative form|alternative spelling|alternative case form|obsolete form|obsolete spelling|archaic form|archaic spelling|misspelling|informal spelling|nonstandard spelling|clipping|clip|abbreviation|abbr|initialism|acronym|ellipsis|synonym|syn) of en \K[^()=]+?(?=  | [a-z]+=|\))' |
    head -1 |
    sed -e 's/[[:space:]]*$//'
}

# The same, from raw templates the converter left in place:
# "{{deliberate misspelling of|en|the|addl=...}}" -> the
form_of_raw() {
  jq -r '[.[].definition] | join("\n")' <<<"$1" | grep -oP '\{\{[a-z ]+ of\|en\|\K[^|}]+' | head -1
}

# WordNet's own cross-reference: "went  See {go}".
form_of_wordnet() {
  jq -r '[.[] | select(.dict == "WordNet")][0].definition // ""' <<<"$1" | grep -oP '^\s*See \{\K[^}]+' | head -1
}

# Relation label for the lemma line, e.g. "plural of", "past tense of".
relation_of() {
  local def="$1" lemma="$2"
  wikt_text "$def" |
    grep -oP "\\((plural|infl|inflection|past participle|present participle|simple past|past tense|comparative|superlative|alternative form|alternative spelling|alternative case form|obsolete form|obsolete spelling|archaic form|archaic spelling|misspelling|informal spelling|nonstandard spelling|clipping|clip|abbreviation|abbr|initialism|acronym|ellipsis|synonym|syn) of en \\Q$lemma\\E[^)]*\\)" |
    head -1
}

# Does an entry have English senses? Template language codes tell:
# "(lb en ...)", "(senseid en ...)", "(plural of en ...)". An entry with no
# codes at all is a plain English entry. (Mirrors Model.js parseDefinition.)
english_like() {
  local def
  # WordNet is an English dictionary: if it has the word, the word is English.
  jq -e 'any(.[]; .dict == "WordNet")' <<<"$1" >/dev/null 2>&1 && return 0
  def="$(jq -r '[.[].definition] | join("\n")' <<<"$1")"
  grep -qP '\((?:lb|lbl|l|m|senseid|sid|[a-z ]+ of) en ' <<<"$def" && return 0
  ! grep -qP '\((?:lb|lbl|l|m|senseid|sid) [a-z]{2,3}(?:-[a-z]+)? ' <<<"$def"
}

# Near-miss headwords for a word that didn't match (single words only).
# sdcv's glob search returns at most 100 headwords, alphabetically, so a
# short prefix alone misses long words: use a long prefix, a half-word
# prefix, and "first3*last2" (catches swapped letters: rec*ve -> receive),
# plus exact lookups of every adjacent-letter swap (teh -> the). ~0.3-0.8s,
# paid only on a miss.
candidates() {
  local w="$1" n=${#1} i sw
  [[ "$w" != *" "* && $n -ge 3 ]] || { echo '[]'; return; }
  {
    (( n >= 5 )) && sdcv -n --json-output -- "${w:0:n-2}*" 2>/dev/null
    sdcv -n --json-output -- "${w:0:$(( n / 2 > 3 ? n / 2 : 3 ))}*" 2>/dev/null
    (( n >= 6 )) && sdcv -n --json-output -- "${w:0:3}*${w: -2}" 2>/dev/null
    for (( i = 0; i < n - 1; i++ )); do
      sw="${w:0:i}${w:i+1:1}${w:i:1}${w:i+2}"
      [[ "$sw" != "$w" ]] && exact "$sw"
    done
  } | jq -s -c '[.[][]?.word] | unique | .[:400]' 2>/dev/null
}

lookup() {  # $1 query -> JSON line on stdout
  local query="$1" lower word="" via="" entries="[]" c lemma="" lemma_json="null" rel suggestions="[]"
  lower="${query,,}"

  entries="$(exact "$query")"
  if nonempty "$entries"; then word="$query"; via="exact"
  elif [[ "$lower" != "$query" ]] && entries="$(exact "$lower")" && nonempty "$entries"; then
    word="$lower"; via="lowercase"
  else
    entries="[]"
    if [[ "$lower" != *" "* ]]; then
      while IFS= read -r c; do
        [[ -n "$c" && ${#c} -ge 2 && "$c" != "$lower" ]] || continue
        entries="$(exact "$c")"
        if nonempty "$entries"; then word="$c"; via="stem"; break; fi
        entries="[]"
      done < <(stems "$lower")
    fi
  fi

  if nonempty "$entries" && ! english_like "$entries"; then
    # Exact hit, but only as a word in other languages ("teh"): keep the
    # entry and still collect English near-misses for "Did you mean".
    suggestions="$(candidates "$lower")"
    [[ -n "$suggestions" ]] || suggestions="[]"
  fi

  if nonempty "$entries"; then
    lemma="$(form_of "$entries")"
    [[ -n "$lemma" ]] || lemma="$(form_of_raw "$entries")"
    [[ -n "$lemma" ]] || lemma="$(form_of_wordnet "$entries")"
    if [[ -n "$lemma" && "${lemma,,}" != "${word,,}" ]]; then
      local lemma_entries
      lemma_entries="$(exact "$lemma")"
      if nonempty "$lemma_entries"; then
        rel="$(relation_of "$entries" "$lemma")"
        [[ -n "$rel" ]] || rel="$(jq -r '[.[].definition] | join("\n")' <<<"$entries" | grep -oP "\\{\\{[a-z ]+ of\\|en\\|\\Q$lemma\\E[^}]*\\}\\}" | head -1)"
        lemma_json="$(jq -c --arg w "$lemma" --arg rel "$rel" '{word: $w, relation: $rel, entries: .}' <<<"$lemma_entries")"
      fi
    fi
  else
    # Nothing matched: collect near-miss HEADWORDS for "Did you mean".
    # (v0.1 used sdcv's fuzzy search and showed those words' definitions as
    # if they belonged to the query.) Model.js ranks these by edit distance
    # and drops anything that isn't close.
    suggestions="$(candidates "$lower")"
    [[ -n "$suggestions" ]] || suggestions="[]"
  fi

  # A phrase with no entry of its own ("premium subscribers"): look up its
  # words one by one, so the card can still say what each part means.
  local parts="[]" part can_explain=false
  if ! nonempty "$entries" && [[ "$query" == *" "* && -z "${DICT_NO_PARTS:-}" ]]; then
    local -a pw
    read -r -a pw <<<"$query"
    parts="$(for part in "${pw[@]}"; do DICT_NO_PARTS=1 lookup "$part"; done | jq -s -c '[.[] | select(.found) | del(.x, .y)]')"
    [[ -n "$parts" ]] || parts="[]"
  fi
  # On a miss, tell the card whether the local model could explain it
  # instead (the Define key). Cheap: Ollama answers /api/tags in ~ms.
  if ! nonempty "$entries" && [[ -z "${DICT_NO_PARTS:-}" ]]; then
    local url; url="$(ollama_url)"
    if { loopback "$url" || [[ "${OMARCHY_DICT_ALLOW_REMOTE:-}" == 1 ]]; } && [[ -n "$(pick_model "$url")" ]]; then
      can_explain=true
    fi
  fi

  local pos x y
  pos="$(hyprctl cursorpos 2>/dev/null)"
  x="${pos%%,*}"; y="${pos##*, }"
  [[ "$x" =~ ^-?[0-9]+$ ]] || x=0
  [[ "$y" =~ ^-?[0-9]+$ ]] || y=0

  jq -nc --arg q "$query" --arg w "$word" --arg via "$via" \
    --argjson entries "$entries" --argjson lemma "$lemma_json" --argjson sugg "$suggestions" \
    --argjson parts "$parts" --argjson canExplain "$can_explain" \
    --argjson x "$x" --argjson y "$y" \
    '{query: $q, word: $w, via: $via, entries: $entries, lemma: $lemma,
      suggestions: $sugg, parts: $parts, canExplain: $canExplain,
      found: (($entries | length) > 0), x: $x, y: $y}'
}

# Trim, collapse whitespace and strip surrounding punctuation/quotes.
# Prints nothing if the selection doesn't look like a word or short phrase.
normalize() {
  local t="$1"
  t="${t//$'\r'/ }"; t="${t//$'\n'/ }"; t="${t//$'\t'/ }"
  (( ${#t} <= MAX_LEN * 2 )) || return 0
  t="$(printf '%s' "$t" | tr -s ' ' | sed -E "s/^[[:space:][:punct:]“”‘’«»]+//; s/[[:space:][:punct:]“”‘’«»]+$//")"
  (( ${#t} >= 2 && ${#t} <= MAX_LEN )) || return 0
  local -a words
  read -r -a words <<<"$t"
  (( ${#words[@]} <= MAX_WORDS )) || return 0
  # Letters (any script), with inner apostrophes or hyphens. Anything with
  # digits, slashes, dots, @ ... is code, a path, a URL or a secret -- not a
  # dictionary word.
  local w
  for w in "${words[@]}"; do
    [[ "$w" =~ ^[[:alpha:]]+([\'’-][[:alpha:]]+)*$ ]] || return 0
  done
  printf '%s' "$t"
}

denied_window() {
  local cls
  cls="$(hyprctl activewindow -j 2>/dev/null | jq -r '(.class // "") + " " + (.initialClass // "")' 2>/dev/null)"
  [[ -n "$DENY_CLASSES" && "${cls,,}" =~ ($DENY_CLASSES) ]]
}

have_dictionary() {
  command -v sdcv >/dev/null 2>&1 || { log "sdcv not found on PATH"; return 1; }
  local n
  n="$(sdcv -l 2>/dev/null | tail -n +2 | grep -c . || true)"
  (( ${n:-0} > 0 )) || { log "sdcv has no dictionaries installed (sdcv -l is empty)"; return 1; }
}

handle_one() {
  # Invoked by wl-paste --watch once per selection change, content on stdin.
  local raw query now started seq mine
  raw="$(head -c 4096 | tr -d '\000')"
  is_text "$raw" || return 0

  now="${EPOCHREALTIME/./}"
  started="${DICT_WATCH_STARTED:-0}"
  (( now - started >= STARTUP_GRACE_US )) || return 0

  query="$(normalize "$raw")"
  [[ -n "$query" ]] || return 0
  denied_window && return 0

  # Debounce: only the last selection of a burst gets looked up.
  mkdir -p "$runtime" && chmod 700 "$runtime"
  mine="$now"
  printf '%s\n' "$mine" > "$runtime/seq"
  sleep "$DEBOUNCE"
  read -r seq < "$runtime/seq" 2>/dev/null || seq=""
  [[ "$seq" == "$mine" ]] || return 0

  lookup "$query"
}

# ---- interpretation by a local model (Ollama) ----------------------------
#
# The dictionary handles words. Phrases, idioms, sentences -- and words the
# dictionary doesn't know -- can be explained by a small local model through
# Ollama. Output is labelled as an interpretation on the card, never styled
# as a definition.
#
#   OMARCHY_DICT_MODEL         model to use (default: first installed of a
#                              list of small instruct models)
#   OLLAMA_HOST                Ollama address (default 127.0.0.1:11434)
#   OMARCHY_DICT_ALLOW_REMOTE  set to 1 to allow a non-loopback OLLAMA_HOST;
#                              otherwise highlighted text never leaves the
#                              machine
#   OMARCHY_DICT_KEEP_ALIVE    how long Ollama keeps the model loaded (5m)

MAX_EXPLAIN=1200
PREFERRED_MODELS="qwen2.5:3b-instruct qwen2.5:3b llama3.2:3b llama3.2 gemma3:4b phi3.5 qwen2.5:1.5b-instruct gemma3:1b llama3.2:1b qwen2.5:7b-instruct qwen2.5:7b llama3.1:8b"

ollama_url() {
  local h="${OLLAMA_HOST:-127.0.0.1:11434}"
  [[ "$h" == *://* ]] || h="http://$h"
  printf '%s' "${h%/}"
}

loopback() {
  local hostport="${1#*://}"; hostport="${hostport%%/*}"
  local host="${hostport%:*}"
  [[ "$host" == "127."* || "$host" == localhost || "$host" == "[::1]" || "$host" == "::1" ]]
}

# Prints the model name, or nothing if Ollama or a usable model isn't there.
pick_model() {
  local url="$1" tags m
  tags="$(curl -s -m 1.5 "$url/api/tags" 2>/dev/null)" || return 0
  [[ -n "$tags" ]] || return 0
  if [[ -n "${OMARCHY_DICT_MODEL:-}" ]]; then
    jq -e --arg m "$OMARCHY_DICT_MODEL" 'any(.models[]?; .name == $m or .model == $m)' <<<"$tags" >/dev/null 2>&1 &&
      printf '%s' "$OMARCHY_DICT_MODEL"
    return 0
  fi
  for m in $PREFERRED_MODELS; do
    if jq -e --arg m "$m" 'any(.models[]?; .name == $m or .name == ($m + ":latest"))' <<<"$tags" >/dev/null 2>&1; then
      printf '%s' "$m"; return 0
    fi
  done
  # Anything else that isn't an embedding model.
  jq -r '[.models[]?.name | select(test("embed|bge|minilm|rerank"; "i") | not)][0] // empty' <<<"$tags"
}

explain_error() {  # $1 code, $2 message
  jq -nc --arg c "$1" --arg m "$2" '{kind: "explain", error: $c, message: $m}'
}

# Stream an explanation of $1 as JSON lines:
#   {"kind":"explain","query","model","text","done","x","y"}
# `text` is the whole explanation so far (the card just re-renders it).
explain() {
  local text="$1" url model system prompt x y pos
  url="$(ollama_url)"
  if ! loopback "$url" && [[ "${OMARCHY_DICT_ALLOW_REMOTE:-}" != 1 ]]; then
    explain_error remote-host "OLLAMA_HOST is not on this machine; set OMARCHY_DICT_ALLOW_REMOTE=1 to allow it."
    return
  fi
  model="$(pick_model "$url")"
  if [[ -z "$model" ]]; then
    if curl -s -m 1.5 "$url/api/tags" >/dev/null 2>&1; then
      if [[ -n "${OMARCHY_DICT_MODEL:-}" ]]; then
        explain_error no-model "Model $OMARCHY_DICT_MODEL isn't installed. Try: ollama pull $OMARCHY_DICT_MODEL"
      else
        explain_error no-model "Ollama has no chat model. Try: ollama pull qwen2.5:3b-instruct"
      fi
    else
      explain_error no-ollama "Local model not available (Ollama isn't running)."
    fi
    return
  fi

  pos="$(hyprctl cursorpos 2>/dev/null)"
  x="${pos%%,*}"; y="${pos##*, }"
  [[ "$x" =~ ^-?[0-9]+$ ]] || x=0
  [[ "$y" =~ ^-?[0-9]+$ ]] || y=0

  system="You explain text someone has highlighted while reading. Reply in English, in at most three short sentences and under 70 words. Say what it means, not what it says. Name idioms, jargon, abbreviations or foreign phrases as such and give their meaning. If it is a single word or name, say what it is. If you are not sure, say so briefly. No preamble, no markdown."
  prompt="Highlighted text:
\"\"\"
$text
\"\"\""

  # Announce immediately so the card can show "Interpreting…" while the
  # model loads (a cold start takes a few seconds).
  jq -nc --arg q "$text" --arg m "$model" --argjson x "$x" --argjson y "$y" \
    '{kind: "explain", query: $q, model: $m, text: "", done: false, x: $x, y: $y}'

  jq -nc --arg m "$model" --arg s "$system" --arg p "$prompt" --arg k "${OMARCHY_DICT_KEEP_ALIVE:-5m}" \
    '{model: $m, system: $s, prompt: $p, stream: true, keep_alive: $k,
      options: {temperature: 0.2, num_predict: 180}}' |
  curl -sN -m 60 "$url/api/generate" -H 'Content-Type: application/json' --data-binary @- 2>/dev/null |
  jq -c --unbuffered -n --arg q "$text" --arg m "$model" --argjson x "$x" --argjson y "$y" '
    foreach (inputs | objects) as $e ({t: "", err: ""};
      .t += ($e.response // "") | .err = ($e.error // "");
      {kind: "explain", query: $q, model: $m, text: .t, done: ($e.done // false),
       x: $x, y: $y} + (if .err != "" then {error: "model-error", message: .err} else {} end))
  '
}

# Clean a selection for the model: whitespace collapsed, length capped.
explain_text() {
  local t="$1"
  t="$(printf '%s' "$t" | tr '\r\n\t' '   ' | tr -s ' ' | sed -E 's/^ +//; s/ +$//')"
  (( ${#t} <= MAX_EXPLAIN )) || t="${t:0:MAX_EXPLAIN}…"
  printf '%s' "$t"
}

# "Define selection": a word goes to the dictionary; if the dictionary has
# nothing -- or the selection is a phrase or a sentence -- the model explains.
define_selection() {  # $1 = "force-model" to skip the dictionary
  local raw word out
  denied_window && { echo '{"error":"denied-window"}'; return; }
  raw="$(read_selection 8192)"
  [[ -n "${raw//[[:space:]]/}" ]] || { echo '{"error":"no-word"}'; return; }
  is_text "$raw" || { echo '{"error":"not-text"}'; return; }
  word="$(normalize "$raw")"
  if [[ -n "$word" && "${1:-}" != force-model ]] && have_dictionary; then
    out="$(lookup "$word")"
    if jq -e '.found' <<<"$out" >/dev/null 2>&1 && english_like "$(jq -c .entries <<<"$out")"; then
      printf '%s\n' "$out"
      return
    fi
  fi
  explain "$(explain_text "$raw")"
}

case "${1:-}" in
  --define)
    define_selection
    exit 0
    ;;
  --explain)
    if [[ -n "${2:-}" ]]; then
      is_text "$2" || { echo '{"error":"not-text"}'; exit 0; }
      explain "$(explain_text "$2")"
    else
      define_selection force-model
    fi
    exit 0
    ;;
  --handle)
    handle_one
    exit 0
    ;;
  --lookup)
    have_dictionary || { echo '{"error":"no-dictionary"}'; exit 0; }
    q="$(normalize "${2:-}")"
    [[ -n "$q" ]] || q="${2:-}"
    [[ -n "$q" ]] && lookup "$q"
    exit 0
    ;;
  --selection)
    have_dictionary || { echo '{"error":"no-dictionary"}'; exit 0; }
    denied_window && { echo '{"error":"denied-window"}'; exit 0; }
    q="$(normalize "$(read_selection 4096)")"
    if [[ -n "$q" ]]; then lookup "$q"; else echo '{"error":"no-word"}'; fi
    exit 0
    ;;
  --state)
    mkdir -p "$state_dir"
    case "${2:-}" in
      on|off) printf '%s\n' "$2" > "$state_dir/active" ;;
      *) cat "$state_dir/active" 2>/dev/null || echo off ;;
    esac
    exit 0
    ;;
esac

# ---- watch mode ----------------------------------------------------------

if ! have_dictionary; then
  echo '{"error":"no-dictionary"}'
  # Stay alive (idle) so Service.qml doesn't restart us in a tight loop.
  exec sleep infinity
fi

export DICT_WATCH_STARTED="${EPOCHREALTIME/./}"
exec wl-paste --primary --type text --watch "$0" --handle
